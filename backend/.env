# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=development

# Secret key for JWT authentication
JWT_SECRET=ai_chatbot_secret_2026

# ========================================
# Ollama Configuration
# ========================================
# Ollama local server URL
OLLAMA_URL=http://localhost:11434

# Enable Ollama
USE_OLLAMA=true

# Default AI Model
OLLAMA_MODEL=llama3

# ========================================
# Optional Cloud AI APIs
# ========================================
# Uncomment only if you want cloud AI services

# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=sqlite:///./chatbot.db

# ========================================
# CORS Configuration
# ========================================
# Frontend URLs allowed to access backend

CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ========================================
# API Configuration
# ========================================
API_TIMEOUT=60000

# ========================================
# Logging
# ========================================
LOG_LEVEL=debug