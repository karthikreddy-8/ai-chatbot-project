# ========================================
# Production Environment Configuration
# ========================================
# This file is for production deployment
# DO NOT commit API keys to version control
# Use platform environment variables instead

# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=production

# ========================================
# Production: Cloud AI APIs
# ========================================
# For Render, Railway, Vercel Backend, etc.
# Set these environment variables on the platform

# Google Gemini API Key
# GEMINI_API_KEY=your_production_gemini_api_key

# OpenAI API Key
# OPENAI_API_KEY=your_production_openai_api_key

# ========================================
# Disable Local Ollama in Production
# ========================================
USE_OLLAMA=false

# ========================================
# CORS Configuration
# ========================================
# Update with your frontend deployment URL
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-domain.com
